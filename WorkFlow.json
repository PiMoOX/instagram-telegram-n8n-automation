    {
      "parameters": {
        "jsCode": "// ... (کد دست‌نخورده باقی می‌ماند، فقط MY_PAGE_ID را جایگزین کنید)\nif (!items || items.length === 0) return [];\n\nconst msg = items[0].json.message;\n\nif (!msg || (msg.from && msg.from.is_bot)) return [];\n\nif (!msg.reply_to_message) return [];\n\nconst originalText = msg.reply_to_message.text || msg.reply_to_message.caption || '';\nconst idMatch =\n  originalText.match(/🆔\\s*ID[:\\s]*([0-9]+)/) ||\n  originalText.match(/([0-9]{6,})/);\nif (!idMatch) return [];\n\nconst customerId = idMatch[1];\n\nfunction mediaItem(attachmentType, fileId, customerId) {\n  return [{ json: {\n    hasFile: true,\n    attachment_type: attachmentType,\n    customer_id: customerId,\n    telegram_file_id: fileId\n  } }];\n}\n\nif (msg.photo && msg.photo.length > 0) {\n  return mediaItem('image', msg.photo[msg.photo.length - 1].file_id, customerId);\n}\n\nif (msg.voice || msg.audio) {\n  return mediaItem('audio', (msg.voice || msg.audio).file_id, customerId);\n}\n\nif (msg.video || msg.video_note) {\n  return mediaItem('video', (msg.video || msg.video_note).file_id, customerId);\n}\n\nif (!msg.text) return [];\nreturn [{ json: {\n  hasFile: false,\n  customer_id: customerId,\n  reply_text: msg.text\n} }];\n"
      },
