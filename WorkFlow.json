      "id": "944bccb5-7307-42b1-96e2-2b8f7a0e8a5d",
      "name": "Send a photo message"
    },
    {
      "parameters": {
        "jsCode": "// REFACTORED — \"Code in JavaScript\" (Instagram webhook path)\n// NOTE: Replace MY_PAGE_ID with your own Instagram Page ID\n\nif (!items || items.length === 0) return [];\n\nconst body = items[0].json.body || items[0].json;\n\nfunction escapeHtml(str) {\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nconst first = (...vals) => vals.find((v) => v) || '';\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seen = staticData.seen || [];\nconst eventKey = body.event_id || body.data?.message?.mid || null;\n\nif (eventKey) {\n  if (staticData.seen.includes(eventKey)) {\n    return [];\n  }\n  staticData.seen.push(eventKey);\n  if (staticData.seen.length > 300) staticData.seen.shift();\n}\n\nconst isInstagram = !!body.event_type;\nconst MY_PAGE_ID = 'YOUR_INSTAGRAM_PAGE_ID';\n\nconst profilePic      = first(body.profile_pic, body.data?.profile_pic, body.data?.result?.profile_pic);\nconst profileUsername = first(body.username,    body.data?.username,    body.data?.result?.username);\nconst profileName     = first(body.name,        body.data?.name,        body.data?.result?.name);\nconst profileUserId   = first(body.sender_id,   body.data?.sender?.id,  body.data?.result?.id);\n\nconst isProfileEvent =\n  (isInstagram && String(body.event_type || '').toLowerCase().includes('profile')) ||\n  (!body.data?.message && !!profilePic && !!profileUsername);\n\nif (isProfileEvent) {\n  return [{\n    json: {\n      isVoiceMessage: false,\n      isImageMessage: false,\n      isProfileUpdate: true,\n      user_id: String(profileUserId || 'unknown'),\n      username: String(profileUsername || ''),\n      name: String(profileName || ''),\n      profile_pic: String(profilePic),\n      received_at: new Date().toISOString(),\n      raw: body\n    }\n  }];\n}\n\nif (isInstagram && !body.data?.message) {\n  return [];\n}\n\nif (isInstagram && String(body.data?.sender?.id || '') === MY_PAGE_ID) {\n  return [];\n}\n\nconst attachments = body.data?.message?.attachments;\nif (isInstagram && Array.isArray(attachments) && attachments.length > 0) {\n  const att = attachments[0];\n  const senderId = String(body.data?.sender?.id || 'unknown');\n  const base = {\n    isProfileUpdate: false,\n    user_id: senderId,\n    username: 'instagram_user_' + senderId,\n    message_id: String(body.data?.message?.mid || ('msg_' + Date.now())),\n    received_at: new Date().toISOString()\n  };\n\n  if (att.type === 'audio' || att.type === 'voice') {\n    return [{\n      json: {\n        ...base,\n        isVoiceMessage: true,\n        isImageMessage: false,\n        voice_url: att.payload?.url || att.url || ''\n      }\n    }];\n  }\n\n  if (att.type === 'image') {\n    return [{\n      json: {\n        ...base,\n        isVoiceMessage: false,\n        isImageMessage: true,\n        image_url: att.payload?.url || att.url || '',\n        caption: escapeHtml(String(body.data?.message?.text || ''))\n      }\n    }];\n  }\n}\n\nconst messageId = body.data?.message?.mid || body.event_id || ('msg_' + Date.now());\nconst senderId  = body.data?.sender?.id || 'unknown';\nconst text      = body.data?.message?.text || '';\n\nif (!text) {\n  return [];\n}\n\nreturn [{\n  json: {\n    isVoiceMessage: false,\n    isImageMessage: false,\n    isProfileUpdate: false,\n    user_id: String(senderId),\n    username: 'instagram_user_' + senderId,\n    message: escapeHtml(String(text)),\n    message_id: String(messageId),\n    received_at: new Date().toISOString(),\n    raw: body\n  }\n}];\n"
      },
